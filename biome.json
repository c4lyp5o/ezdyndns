{
	"$schema": "https://biomejs.dev/schemas/2.2.3/schema.json",
	"organizeImports": {
		"enabled": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"files": {
		"ignore": ["node_modules/**", "bun.lock", "frontend/public/htmx.min.js"]
	}
}