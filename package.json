{
  "name": "ezdyndns",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "scripts": {
    "install:backend": "cd backend && bun install",
    "install:frontend": "cd frontend && bun install",
    "install": "bun run install:backend",
    "dev:backend": "cd backend && bun --watch index.js",
    "dev:frontend": "echo 'no build step - frontend is static htmx'",
    "dev": "bun run dev:backend",
    "test:backend": "cd backend && bun test",
    "test": "bun run test:backend",
    "lint": "bunx @biomejs/biome@2.2.3 lint .",
    "vendor": "./scripts/vendor-frontend.sh",
    "start": "pm2-runtime start ecosystem.config.js --env production",
    "stop": "pm2 stop all",
    "restart": "pm2 restart all",
    "logs": "pm2 monit"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "license": "MIT"
}
