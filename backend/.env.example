# === REQUIRED (server refuses to boot without these) ===

# AES-256-GCM key for encrypting provider credentials at rest in SQLite.
# Generate: openssl rand -base64 32
EZDYNDNS_ENCRYPTION_KEY=

# Management API token. All /api/* and /partials/* requests require
# header: x-api-token: <this>. Generate: openssl rand -hex 24
EZDYNDNS_TOKEN=

# === OPTIONAL ===

# Listen port (default 5070)
PORT=5070

# Listen host: 0.0.0.0 = reachable from the LAN (UI + API are token-gated),
# 127.0.0.1 = loopback only (default)
# EZDYNDNS_HOST=0.0.0.0

# SQLite path (default: ../db/ezdyndns.db relative to backend/)
# EZDYNDNS_DB=/path/to/ezdyndns.db

# ntfy push notifications (IP change / update failure / stalled check loop).
# Full topic URL — leave unset to disable notifications entirely.
# EZDYNDNS_NTFY_URL=https://ntfy.example.com/ezdyndns