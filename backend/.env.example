# === REQUIRED (server refuses to boot without these) ===

# AES-256-GCM key for encrypting provider credentials at rest in SQLite.
# Generate: openssl rand -base64 32
EZDYNDNS_ENCRYPTION_KEY=

# Management API token. All /api/* and /partials/* requests require
# header: x-api-token: <this>. Generate: openssl rand -hex 24
EZDYNDNS_TOKEN=

# === OPTIONAL ===

# Listen port (default 5070)
PORT=5070

# Listen host: 0.0.0.0 = reachable from the LAN (UI + API are token-gated),
# 127.0.0.1 = loopback only (default)
# EZDYNDNS_HOST=0.0.0.0

# SQLite path (default: ../db/ezdyndns.db relative to backend/)
# EZDYNDNS_DB=/path/to/ezdyndns.db

# ntfy push notifications (IP change / update failure / stalled check loop).
# Full topic URL — leave unset to disable notifications entirely.
# EZDYNDNS_NTFY_URL=https://ntfy.example.com/ezdyndns
# More notification channels; set any combination. Each gets the same events:
# ip-changed, update-failed, recovered, needs-attention, ip-inconclusive, stalled.
# Generic webhook: POST {event, title, message, priority, tags} as JSON.
# EZDYNDNS_WEBHOOK_URL=https://example.com/hooks/ezdyndns
# EZDYNDNS_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# EZDYNDNS_GOTIFY_URL=https://gotify.example.com
# EZDYNDNS_GOTIFY_TOKEN=

# Update-log retention in days (defaults 3 and 30; skipped cycles keep 1 day).
# EZDYNDNS_KEEP_SUCCESS_DAYS=3
# EZDYNDNS_KEEP_FAILURE_DAYS=30

# Contact sent in the User-Agent to No-IP / dyndns2 servers, which ask clients
# to name a maintainer. Defaults to the project URL.
# EZDYNDNS_CONTACT=you@example.com

# Background "does it resolve?" checks query public resolvers and each zone's
# nameservers over DNS port 53. Set to 0 where outbound DNS is blocked.
# EZDYNDNS_RESOLVE_CHECKS=1
